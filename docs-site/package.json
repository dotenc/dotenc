{
	"name": "@dotenc/docs",
	"private": true,
	"type": "module",
	"scripts": {
		"content:prepare": "bun scripts/prepare.ts",
		"dev": "bun run content:prepare && astro dev --host 127.0.0.1 --port 4321",
		"build": "bun run content:prepare && astro build",
		"check": "bun run content:prepare && astro check",
		"test": "bun test --isolate tests",
		"validate:links": "bun scripts/check-links.ts",
		"validate:cli": "bun scripts/check-cli.ts"
	},
	"dependencies": {
		"@astrojs/starlight": "0.42.1",
		"astro": "7.3.3",
		"@astrojs/markdown-remark": "7.3.1"
	},
	"devDependencies": {
		"@astrojs/check": "0.9.10",
		"typescript": "^5.8.2",
		"@types/bun": "^1.4.2"
	}
}
